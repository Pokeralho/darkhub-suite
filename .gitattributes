# Auto-normalize line endings for cross-platform compatibility
* text=auto

# Text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.rs text eol=lf
*.cs text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.exe binary
*.dll binary
*.pdb binary
*.obj binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.7z binary
*.tar.gz binary

# ------------------------------------------------------------------------------
# GitHub language statistics (Linguist)
# Generated files are excluded so the repository shows up as TypeScript/JavaScript
# instead of HTML (graphify-out/graph.html alone is ~4.7 MB).
# ------------------------------------------------------------------------------
graphify-out/** linguist-generated=true
docs/map/** linguist-generated=true
docs/hub/BUILTIN.md linguist-generated=true
package-lock.json linguist-generated=true

# Third-party binaries and libraries shipped as-is
electron/services/hwsensors/*.dll linguist-vendored=true
electron/services/fsr4_rdna2/** linguist-vendored=true
