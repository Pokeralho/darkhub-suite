# ====================================================================
# DarkHub Suite - optional environment variables
# ====================================================================
# Nothing here is needed to build or run the app.
#
# The app does not load a .env file: these are read from the real environment of the process, so set them in the
# shell that starts it (PowerShell: $env:NAME = 'value'; npm run dev).
#
# There is no telemetry or bug-report webhook: the old Discord reporter was removed in 0.7.4.

# Custom license verification URL (leave unset for the open-source mode). Read by electron/configManager.js.
DARKHUB_LICENSE_VERIFY_URL=
