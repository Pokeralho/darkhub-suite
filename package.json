{
  "name": "darkhub-suite",
  "version": "0.7.4",
  "description": "High-performance modular Windows utility suite for gamers and power users.",
  "author": "DarkHub Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-admin.ps1",
    "dev:legacy": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:x64 /optimize+ /out:electron\\services\\DarkHub.LatencyEngine.exe electron\\services\\DarkHub.LatencyEngine.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:x64 /optimize+ /out:electron\\services\\DarkHub.FrameLimiter.exe electron\\services\\DarkHub.FrameLimiter.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:x64 /optimize+ /out:electron\\services\\DarkHub.ClickEngine.exe electron\\services\\DarkHub.ClickEngine.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:x64 /optimize+ /out:electron\\services\\DarkHub.SensorDaemon.exe electron\\services\\DarkHub.SensorDaemon.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:x64 /optimize+ /out:electron\\services\\DarkHub.DiskScan.exe electron\\services\\DarkHub.DiskScan.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:x64 /optimize+ /out:electron\\services\\hwsensors\\DarkHub.HwSensors.exe /r:electron\\services\\hwsensors\\LibreHardwareMonitorLib.dll /r:System.Management.dll electron\\services\\hwsensors\\DarkHub.HwSensors.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:anycpu /optimize+ /out:electron\\services\\DarkHub.VaultBridgeHost.exe electron\\services\\DarkHub.VaultBridgeHost.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:anycpu /optimize+ /r:System.Web.Extensions.dll /out:electron\\services\\DarkHub.Mcp.exe electron\\services\\DarkHub.Mcp.cs; & C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:exe /platform:anycpu /optimize+ /out:electron\\services\\DarkHub.HotkeyWatch.exe electron\\services\\DarkHub.HotkeyWatch.cs\"",
    "build:renderer": "vite build",
    "build:pacer": "cargo build --release --manifest-path native_pacer/Cargo.toml && powershell -NoProfile -Command \"Copy-Item native_pacer/target/release/DarkHub_PacerHook.dll electron/services/DarkHub.PacerHook.dll -Force\"",
    "test:pacer": "cargo test --manifest-path native_pacer/Cargo.toml -- --test-threads=1",
    "build": "npm run build:native && npm run build:pacer && npm run build:renderer && electron-builder",
    "build:setup-sfx": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-sfx-setup.ps1",
    "build:setup-nsis": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$nsis=Join-Path $env:LOCALAPPDATA 'electron-builder\\Cache\\nsis\\nsis-3.0.4.1-nsis-3.0.4.1\\Bin\\makensis.exe'; & $nsis installer\\darkhub.nsi\"",
    "build:setup-inno": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-inno-setup.ps1",
    "build:portable": "npm run build:renderer && electron-builder --win portable",
    "test:unit": "vitest run",
    "map": "python \"D:/Workspace/NexusOrchestrator/pytools/electron_feature_map.py\" --project . && graphify update .",
    "map:find": "python \"D:/Workspace/NexusOrchestrator/pytools/electron_feature_map.py\" --project . --find",
    "test:watch": "vitest",
    "test:feature": "vitest --dir tests",
    "shot": "electron scripts/shot.cjs",
    "selftest": "node -e \"process.env.DARKHUB_SELFTEST='1';process.exit(require('child_process').spawnSync(require('electron'),['.'],{stdio:'inherit',env:process.env}).status)\"",
    "hub:docs": "node scripts/hub-docs.mjs",
    "hub:validate": "node scripts/hub-validate.mjs",
    "hub:core": "node scripts/hub-core.mjs",
    "ext:new": "node scripts/ext.mjs new",
    "ext:pack": "node scripts/ext.mjs pack"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "diff": "^9.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^30.3.0",
    "ffmpeg-static": "^5.2.0",
    "js-yaml": "^4.1.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "1.5.4",
    "sharp": "^0.34.3",
    "systeminformation": "^5.27.7",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "crypto-js": "^4.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^3.2.1",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.darkhub.app",
    "productName": "DarkHub",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false
    },
    "directories": {
      "output": "dist_release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "pt-PT",
      "en-US",
      "en"
    ],
    "asarUnpack": [
      "electron/*.ps1",
      "electron/services/*.exe",
      "electron/services/*.dll",
      "electron/services/*.ps1",
      "electron/services/darkos/*.ps1",
      "electron/services/darkos/*.psm1",
      "electron/services/darkos/policy/**",
      "electron/services/hub/schema/**",
      "electron/services/hwsensors/**",
      "electron/services/fsr4_rdna2/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/exiftool-vendored.exe/**"
    ],
    "extraResources": [
      {
        "from": "PGE Portable",
        "to": "PGE Portable",
        "filter": [
          "**/*",
          "!**/Static/**",
          "!**/Static.zip"
        ]
      },
      {
        "from": "browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "build/deps",
        "to": "deps"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis",
        "portable",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DarkHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "DarkHub Suite",
      "include": "build/installer.nsh",
      "differentialPackage": false,
      "perMachine": true
    },
    "portable": {
      "artifactName": "${productName} ${version}-portable.${ext}",
      "requestExecutionLevel": "admin"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pokeralho",
        "repo": "darkhub-suite"
      }
    ],
    "protocols": [
      {
        "name": "DarkHub",
        "schemes": [
          "darkhub"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pokeralho/darkhub-suite.git"
  }
}
