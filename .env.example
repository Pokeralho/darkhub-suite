# ====================================================================
# DarkHub Suite - Environment Configuration Template
# ====================================================================
# Copy this file to '.env' and adjust values as needed.
# All variables are optional for normal local use.

# Optional Discord Webhook for bug reports and crash telemetry
DISCORD_BUG_WEBHOOK_URL=

# Optional Custom License Verification URL (Leave blank for Open Source mode)
DARKHUB_LICENSE_VERIFY_URL=

# Optional License HMAC Secret (Leave blank for Open Source mode)
DARKHUB_LICENSE_SECRET=

# Environment mode (development | production)
NODE_ENV=production
