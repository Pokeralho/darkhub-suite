# Auto-normalize line endings for cross-platform compatibility
* text=auto

# Text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.rs text eol=lf
*.cs text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.exe binary
*.dll binary
*.pdb binary
*.obj binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.7z binary
*.tar.gz binary
